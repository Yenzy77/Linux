#!/usr/bin/env bash
set -u
if (($# > 1)) || [[ ${1:-} != "" && ${1:-} != --maintenance ]]; then
    printf 'Usage: %s [--maintenance]\n' "$0" >&2
    exit 2
fi
failures=0
check() {
    local label=$1
    shift
    if "$@" >/dev/null 2>&1; then
        printf 'OK   %s\n' "$label"
    else
        printf 'FAIL %s\n' "$label"
        failures=$((failures + 1))
    fi
}
check_elf() {
    local report
    command -v ldd >/dev/null && pacman -Qo -- "$1" >/dev/null 2>&1 || return 1
    report=$(LC_ALL=C ldd "$1" 2>&1) || return 1
    [[ -n $report && $report != *'not found'* ]]
}
optional() {
    local label=$1
    shift
    if "$@" >/dev/null 2>&1; then
        printf 'OK   %s\n' "$label"
    else
        printf 'WARN %s\n' "$label"
    fi
}
check 'CachyOS' grep -qx ID=cachyos /etc/os-release
check 'Hyprland installed' command -v Hyprland
check 'Matugen installed' command -v matugen
check 'SDDM active' systemctl is-active sddm.service
check 'SDDM theme watcher active' systemctl --user is-active ii-sddm-publish.path
check 'SDDM publisher socket active' systemctl is-active ii-sddm-sync.socket
check 'Limine renderer watcher active' systemctl --user is-active ii-limine-render.path
check 'Limine publisher socket active' systemctl is-active ii-limine-wallpaper.socket
check 'Shared boot lock exists' test -f /run/lock/boot-partition.lock
check 'Brave readiness check' /usr/local/lib/ii-sddm-sync/browser-with-keyring --check-only
if [[ ${1:-} == --maintenance ]]; then
    check 'Pacman dependency database' pacman -Dk
    check 'Quickshell packaged ELF dependencies resolve' check_elf /usr/bin/quickshell
    if pacman -Q libcava >/dev/null 2>&1; then
        optional 'libcava.so.1 dependencies resolve' check_elf /usr/lib/libcava.so.1
    fi
    if pacman -Q droidcam >/dev/null 2>&1; then
        optional 'DroidCam-specific loopback module resolves on the running kernel' modinfo v4l2loopback-dc
        optional 'Generic loopback module resolves on the running kernel' modinfo v4l2loopback
    fi
    if pacman -Q millennium >/dev/null 2>&1; then
        optional 'Millennium x86-64 bootstrap is installed' test -r /usr/lib/millennium/libmillennium_bootstrap_x64.so
    fi
fi
exit "$((failures != 0))"
