{
  "appearance": {
    "extraBackgroundTint": true,
    "fakeScreenRounding": 2,
    "fonts": {
      "expressive": "Space Grotesk",
      "iconNerd": "JetBrains Mono NF",
      "main": "Google Sans Flex",
      "monospace": "JetBrains Mono NF",
      "numbers": "Google Sans Flex",
      "reading": "Readex Pro",
      "title": "Google Sans Flex"
    },
    "palette": {
      "type": "auto"
    },
    "transparency": {
      "automatic": true,
      "backgroundTransparency": 0.11,
      "contentTransparency": 0.57,
      "enable": false
    },
    "wallpaperTheming": {
      "enableAppsAndShell": true,
      "enableQtApps": true,
      "enableTerminal": true,
      "terminalGenerationProps": {
        "forceDarkMode": false,
        "harmonizeThreshold": 100,
        "harmony": 0.6,
        "termFgBoost": 0.35
      }
    }
  },
  "background": {
    "hideWhenFullscreen": true,
    "parallax": {
      "autoVertical": false,
      "enableSidebar": false,
      "enableWorkspace": false,
      "vertical": false,
      "widgetsFactor": 1.2,
      "workspaceZoom": 1.07
    },
    "widgets": {
      "clock": {
        "style": "cookie",
        "styleLocked": "cookie",
        "placementStrategy": "leastBusy",
        "digital": {
          "font": {
            "family": "Google Sans Flex",
            "roundness": 0,
            "size": 90,
            "weight": 350,
            "width": 100
          }
        },
        "cookie": {
          "aiStyling": false,
          "constantlyRotate": false,
          "dateInClock": true,
          "dateStyle": "bubble",
          "dialNumberStyle": "full",
          "hourHandStyle": "fill",
          "hourMarks": true,
          "minuteHandStyle": "medium",
          "secondHandStyle": "dot",
          "sides": 14,
          "timeIndicators": true,
          "useSineCookie": true
        }
      }
    }
  },
  "bar": {
    "topLeftIcon": "spark",
    "workspaces": {
      "numberMap": [
        "1",
        "2"
      ]
    }
  },
  "dock": {
    "pinnedApps": [
      "org.kde.dolphin",
      "kitty"
    ]
  },
  "launcher": {
    "pinnedApps": [
      "org.kde.dolphin",
      "kitty",
      "cmake-gui"
    ]
  },
  "lock": {
    "blur": {
      "enable": true,
      "extraZoom": 1.1,
      "radius": 100
    },
    "centerClock": true,
    "launchOnStartup": false,
    "materialShapeChars": true,
    "security": {
      "requirePasswordToPower": false,
      "unlockKeyring": false
    },
    "showLockedText": true,
    "useHyprlock": false
  },
  "panelFamily": "ii",
  "resources": {
    "historyLength": 60,
    "updateInterval": 3000
  },
  "sidebar": {
    "quickToggles": {
      "android": {
        "toggles": [
          {
            "size": 2,
            "type": "network"
          },
          {
            "size": 2,
            "type": "bluetooth"
          },
          {
            "size": 1,
            "type": "idleInhibitor"
          },
          {
            "size": 1,
            "type": "mic"
          },
          {
            "size": 2,
            "type": "audio"
          },
          {
            "size": 2,
            "type": "nightLight"
          },
          {
            "size": 1,
            "type": "antiFlashbang"
          },
          {
            "size": 1,
            "type": "musicRecognition"
          },
          {
            "size": 1,
            "type": "colorPicker"
          },
          {
            "size": 1,
            "type": "cloudflareWarp"
          },
          {
            "size": 1,
            "type": "darkMode"
          }
        ]
      },
      "style": "android"
    }
  },
  "sounds": {
    "theme": "freedesktop"
  },
  "time": {
    "dateFormat": "ddd, dd/MM",
    "dateWithYearFormat": "dd/MM/yyyy",
    "format": "hh:mm",
    "pomodoro": {
      "breakTime": 300,
      "cyclesBeforeLongBreak": 4,
      "focus": 1500,
      "longBreak": 900
    },
    "secondPrecision": false,
    "shortDateFormat": "dd/MM"
  },
  "waffles": {
    "actionCenter": {
      "toggles": [
        "network",
        "bluetooth",
        "easyEffects",
        "powerProfile",
        "idleInhibitor",
        "nightLight",
        "darkMode",
        "antiFlashbang",
        "cloudflareWarp",
        "mic",
        "musicRecognition",
        "notifications",
        "onScreenKeyboard",
        "gameMode",
        "screenSnip",
        "colorPicker"
      ]
    }
  }
}
